                d = d.Parent
            end

            if not c then
                if not forceFieldOriginalColors[b] then
                    forceFieldOriginalColors[b] = b.Color
                end

                b.Material = Enum.Material.ForceField
                b.Color = forceFieldColor
            end
        end
    end
end

